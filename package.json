{
  "name": "secret-santa",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:api": "wrangler dev --port 8787",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p worker/tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply secret-santa --local",
    "db:migrate:remote": "wrangler d1 migrations apply secret-santa --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "svelte": "^5.59.2",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.4.0",
    "wrangler": "^4.168.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "dependencies": {
    "@fontsource/cedarville-cursive": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0"
  }
}
